{
  "manifest_version": 3,
  "name": "SexyNow",
  "version": "1.0.0",
  "description": "Change a character or outfit in a webpage video.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SexyNow",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine.html",
        "presentation.html",
        "xmax-direct.js",
        "chunk-HHSTQEVL.js",
        "chunk-OWYOGLFU.js",
        "chunk-33YNJZIY.js",
        "chunk-K2DZGV6Q.js",
        "AgoraRTC_N-production-FHAKXOXU.js",
        "chunk-4VNS5WPM.js",
        "trtc-HNQT6WH6.js",
        "index.esm.min-DLKHUTGJ.js",
        "agora-extension-beauty-EDQ6TXHH.js",
        "cos-js-sdk-v5-4GWQE76H.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}